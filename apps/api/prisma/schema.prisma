generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?
  name              String
  avatar            String?
  googleId          String?   @unique
  role              String    @default("USER")
  plan              String    @default("FREE")
  credits           Int       @default(60)
  stripeCustomerId  String?
  stripeSubscriptionId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  videos            Video[]
  clips             Clip[]
  sessions          Session[]
  apiKeys           ApiKey[]
  posts             Post[]
  socialAccounts    SocialAccount[]
  analytics         Analytics[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  name      String
  key       String   @unique
  provider  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Video {
  id             String   @id @default(uuid())
  userId         String
  title          String
  description    String?
  sourceUrl      String?
  sourceType     String   @default("UPLOAD")
  duration       Float?
  thumbnailUrl   String?
  status         String   @default("PENDING")
  transcript     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips          Clip[]
}

model Clip {
  id              String   @id @default(uuid())
  videoId         String
  userId          String
  title           String?
  startTime       Float
  endTime         Float
  duration        Float
  thumbnailUrl    String?
  outputPath      String?
  status          String   @default("PENDING")
  viralScore      Float?
  viralReasons    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  captions        Caption[]
}

model Caption {
  id          String   @id @default(uuid())
  clipId      String
  content     String
  position    String   @default("bottom")
  style       String?
  fontSize    Int      @default(24)
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clip        Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
}

model Post {
  id            String   @id @default(uuid())
  userId        String
  clipId        String?
  platform      String
  status        String   @default("DRAFT")
  scheduledAt   DateTime?
  publishedAt   DateTime?
  postId        String?
  postUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id           String   @id @default(uuid())
  userId       String
  platform     String
  accountId    String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Analytics {
  id          String   @id @default(uuid())
  userId      String
  entityType  String
  entityId    String
  metric      String
  value       Float
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
